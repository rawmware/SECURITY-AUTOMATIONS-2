# Example environment for Aegis 2.0.0.
# Copy to .env and fill in real values. .env is gitignored.

# Dry-run mode: alert/respond actions are logged, not executed.
AEGIS_DRY_RUN=true

# Minimum finding score (0-100) that triggers an alert.
AEGIS_ALERT_THRESHOLD=40.0

# Slack incoming webhook URL for alert delivery.
AEGIS_WEBHOOK_SLACK=

# Discord webhook URL for alert delivery.
AEGIS_WEBHOOK_DISCORD=

# SMTP relay host for email alerts.
AEGIS_SMTP_HOST=

# SMTP username for email alerts.
AEGIS_SMTP_USER=

# SMTP password for email alerts.
AEGIS_SMTP_PASS=
